<script>
        // Micro-interaction for notifications
        document.querySelectorAll('.cursor-pointer').forEach(card => {
            card.addEventListener('click', function() {
                this.classList.add('scale-[0.98]');
                setTimeout(() => {
                    this.classList.remove('scale-[0.98]');
                }, 100);
            });
        });

        // Mark all as read visual feedback
        const markAllBtn = document.querySelector('button');
        markAllBtn.addEventListener('click', function() {
            const unreadLine = document.querySelector('.border-primary');
            if (unreadLine) {
                unreadLine.classList.replace('border-primary', 'border-outline-variant/30');
                unreadLine.classList.add('opacity-80');
                this.innerText = 'All Caught Up!';
                this.classList.remove('text-primary');
                this.classList.add('text-on-surface-variant');
            }
        });
    </script>
