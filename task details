  </head>
<body class="bg-background text-on-background min-h-screen pb-32">
<!-- Top App Bar -->
<header class="w-full top-0 sticky z-40 bg-surface flex justify-between items-center h-16 px-margin-mobile">
<div class="flex items-center gap-3">
<button class="p-2 -ml-2 rounded-full hover:bg-surface-container-low transition-colors active:scale-95">
<span class="material-symbols-outlined text-primary">arrow_back</span>
</button>
<h1 class="font-headline-lg text-headline-lg text-primary">New Task</h1>
</div>
<div class="flex items-center">
<div class="w-8 h-8 rounded-full bg-primary-container flex items-center justify-center overflow-hidden border border-outline-variant">
<img alt="Profile" class="w-full h-full object-cover" data-alt="A professional studio portrait of a modern office professional with soft cinematic lighting. The individual has a friendly expression, set against a clean, minimalist off-white background that complements a high-end corporate identity. The overall aesthetic is bright, sharp, and trustworthy, using a sophisticated cool-toned color palette." src="https://lh3.googleusercontent.com/aida-public/AB6AXuAU6o_VxLy-3RG0Xh1I-XRCY_kYQPrTX8VAKdldwd1M386sU-TgeC8lzchGjsq2kXGx31fz8x4c92HwVqysBMDkIZ2CRtvBPBCZUhGdaigy3QOZjvsPvAOlG_N788Vmfj51MFAnVw6W2keXIBjpobCVcuvEBXM7qEGqOt6iopDY3pcJD7pNOdr2HixWUcusZPzgAAWFbW1fE7gMq3qdVFUqrrO2QIFC4yStWFV1PIU1idDA5BH5l_lqFFShXNnF4HyjbSEcMoLVX80"/>
</div>
</div>
</header>
<main class="px-margin-mobile pt-lg max-w-2xl mx-auto space-y-xl">
<!-- Task Hero Section (Input) -->
<section class="space-y-sm">
<label class="font-label-sm text-label-sm text-on-surface-variant px-1 uppercase tracking-wider" for="task-title">What needs to be done?</label>
<input class="w-full bg-transparent border-none p-0 font-headline-lg text-headline-lg focus:ring-0 placeholder:text-outline-variant text-on-surface" id="task-title" placeholder="Enter task title..." type="text"/>
<div class="h-px w-full bg-gradient-to-r from-primary via-outline-variant to-transparent opacity-30"></div>
</section>
<!-- Description -->
<section class="space-y-sm">
<label class="font-label-sm text-label-sm text-on-surface-variant px-1" for="task-desc">Description</label>
<textarea class="w-full rounded-xl bg-surface-container-low border-2 border-transparent focus:border-primary focus:bg-surface transition-all duration-200 p-md font-body-md text-body-md text-on-surface placeholder:text-outline" id="task-desc" placeholder="Add more details about this task..." rows="4"></textarea>
</section>
<!-- Due Date Picker -->
<section class="space-y-sm">
<label class="font-label-sm text-label-sm text-on-surface-variant px-1">Due Date</label>
<div class="flex items-center gap-md p-md bg-surface border-2 border-outline-variant rounded-xl hover:border-primary cursor-pointer transition-colors group">
<span class="material-symbols-outlined text-primary group-hover:scale-110 transition-transform">calendar_today</span>
<div class="flex-1">
<p class="font-button-md text-button-md text-on-surface">October 24, 2023</p>
<p class="font-label-sm text-label-sm text-on-surface-variant">at 10:00 AM</p>
</div>
<span class="material-symbols-outlined text-outline-variant">chevron_right</span>
</div>
</section>
<!-- Priority Selector -->
<section class="space-y-sm">
<label class="font-label-sm text-label-sm text-on-surface-variant px-1">Priority Level</label>
<div class="flex gap-sm p-sm bg-surface-container rounded-2xl">
<button class="priority-btn flex-1 py-sm rounded-xl font-button-md text-button-md transition-all duration-200 bg-surface text-on-surface-variant hover:bg-surface-bright" data-priority="low" onclick="selectPriority(this)">
                    Low
                </button>
<button class="priority-btn flex-1 py-sm rounded-xl font-button-md text-button-md transition-all duration-200 bg-primary text-on-primary shadow-lg scale-105" data-priority="medium" onclick="selectPriority(this)">
                    Medium
                </button>
<button class="priority-btn flex-1 py-sm rounded-xl font-button-md text-button-md transition-all duration-200 bg-surface text-on-surface-variant hover:bg-surface-bright" data-priority="high" onclick="selectPriority(this)">
                    High
                </button>
</div>
</section>
<!-- Reminder Toggle -->
<section class="flex items-center justify-between p-md bg-surface-container-low rounded-xl border border-outline-variant/30">
<div class="flex items-center gap-md">
<div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
<span class="material-symbols-outlined text-primary">notifications_active</span>
</div>
<div>
<p class="font-button-md text-button-md text-on-surface">Reminder</p>
<p class="font-label-sm text-label-sm text-on-surface-variant">Notify me before start</p>
</div>
</div>
<label class="relative inline-flex items-center cursor-pointer">
<input checked="" class="sr-only peer" type="checkbox" value=""/>
<div class="w-11 h-6 bg-outline-variant peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
</label>
</section>
</main>
<!-- Bottom Action Bar -->
<div class="fixed bottom-0 left-0 w-full p-margin-mobile bg-gradient-to-t from-background via-background to-transparent pt-lg">
<button class="w-full h-[56px] bg-primary text-on-primary font-button-md text-button-md rounded-xl shadow-[0_8px_24px_rgba(53,37,205,0.3)] hover:opacity-90 active:scale-95 transition-all flex items-center justify-center gap-sm">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">check_circle</span>
            Save Task
        </button>
</div>
<!-- Micro-interaction Script -->
<script>
        function selectPriority(element) {
            // Reset all buttons
            document.querySelectorAll('.priority-btn').forEach(btn => {
                btn.classList.remove('bg-primary', 'text-on-primary', 'shadow-lg', 'scale-105');
                btn.classList.add('bg-surface', 'text-on-surface-variant');
            });

            // Set active button
            element.classList.remove('bg-surface', 'text-on-surface-variant');
            element.classList.add('bg-primary', 'text-on-primary', 'shadow-lg', 'scale-105');

            // Feedback vibration if available
            if (window.navigator.vibrate) {
                window.navigator.vibrate(10);
            }
        }

        // Simple float animation for the main input
        const taskTitle = document.getElementById('task-title');
        taskTitle.addEventListener('focus', () => {
            taskTitle.parentElement.querySelector('div').classList.add('opacity-100');
            taskTitle.parentElement.querySelector('div').classList.remove('opacity-30');
        });
        taskTitle.addEventListener('blur', () => {
            taskTitle.parentElement.querySelector('div').classList.remove('opacity-100');
            taskTitle.parentElement.querySelector('div').classList.add('opacity-30');
        });
    </script>
</body></html>
