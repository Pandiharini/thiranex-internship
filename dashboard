<script>
        // Micro-interactions
        document.querySelectorAll('.cursor-pointer').forEach(task => {
            task.addEventListener('click', function() {
                const checkbox = this.querySelector('.material-symbols-outlined.opacity-0');
                if (checkbox) {
                    checkbox.classList.remove('opacity-0');
                    checkbox.parentElement.classList.add('bg-primary', 'border-primary');
                    checkbox.classList.add('text-white');
                    this.querySelector('h3').classList.add('line-through');
                    this.classList.add('opacity-60');
                }
            });
        });

        // Atmosphere effect: Pulse for FAB
        setInterval(() => {
            const fab = document.querySelector('.bg-primary-container');
            fab.classList.add('ring-4', 'ring-primary-container/20');
            setTimeout(() => {
                fab.classList.remove('ring-4', 'ring-primary-container/20');
            }, 1000);
        }, 5000);
    </script>


