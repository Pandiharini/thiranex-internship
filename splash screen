<body class="bg-primary-container text-on-primary select-none overflow-hidden h-screen w-screen flex flex-col items-center justify-center">
<!-- Splash Content Canvas -->
<main class="relative z-10 flex flex-col items-center justify-center w-full max-w-sm px-margin-mobile h-full">
<!-- Background Atmospheric Element -->
<div class="absolute inset-0 z-[-1] overflow-hidden pointer-events-none">
<div class="absolute top-[-10%] left-[-10%] w-[120%] h-[120%] bg-gradient-to-br from-primary-container via-primary to-primary-container opacity-40 blur-3xl"></div>
<div class="absolute bottom-[-20%] right-[-10%] w-[80%] h-[80%] bg-on-primary-fixed-variant opacity-20 blur-3xl rounded-full"></div>
</div>
<!-- Brand Identity Block -->
<div class="flex flex-col items-center gap-lg fade-in">
<!-- Icon Frame -->
<div class="w-24 h-24 bg-surface-container-lowest rounded-xl shadow-lg flex items-center justify-center animate-[pulse-subtle_3s_ease-in-out_infinite]">
<span class="material-symbols-outlined text-[48px] text-primary" data-icon="security" style="font-variation-settings: 'FILL' 1;">security</span>
</div>
<!-- Brand Name -->
<div class="text-center">
<h1 class="font-headline-lg text-headline-lg text-white tracking-tight">SecureTask</h1>
<p class="font-label-sm text-label-sm text-on-primary-container/80 mt-xs uppercase tracking-widest">Enterprise Productivity</p>
</div>
</div>
<!-- Loading Indicator Positioned at Bottom -->
<div class="absolute bottom-16 flex flex-col items-center gap-sm w-48 fade-in" style="animation-delay: 0.3s;">
<!-- Progress Bar Shell -->
<div class="w-full h-1 bg-white/20 rounded-full overflow-hidden">
<div class="h-full bg-white shimmer-bar rounded-full transition-all duration-300 ease-out" id="progress-bar" style="width: 0%;"></div>
</div>
<span class="font-label-sm text-label-sm text-white/60">Initializing encryption...</span>
</div>
</main>
<!-- Script for simulated progress -->
<script>
        document.addEventListener('DOMContentLoaded', () => {
            const progressBar = document.getElementById('progress-bar');
            let width = 0;
            
            const interval = setInterval(() => {
                if (width >= 100) {
                    clearInterval(interval);
                    // Add a small delay before potential redirect or transition
                    setTimeout(() => {
                        progressBar.parentElement.classList.add('opacity-0');
                        progressBar.parentElement.nextElementSibling.innerText = 'System Ready';
                        progressBar.parentElement.nextElementSibling.classList.add('text-white');
                    }, 500);
                } else {
                    // Variable speed for a more realistic feel
                    const increment = Math.random() * 15;
                    width = Math.min(100, width + increment);
                    progressBar.style.width = width + '%';
                }
            }, 400);
        });
    </script>
